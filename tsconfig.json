{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "js/globals.d.ts",
    "js/*.js"
  ],
  "exclude": ["node_modules", "dist", "test-results"]
}
